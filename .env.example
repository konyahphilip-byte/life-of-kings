# Server configuration. Keep this template free of credentials.
API_PORT=8787
ECOVIBES_DB_PATH=server/data/ecovibes.sqlite
DATABASE_URL=
DB_POOL_MAX=8
APP_ORIGINS=http://localhost:5173
# Enable only after npm run build, to serve web + API from one origin.
ECOVIBES_SERVE_WEB=false
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
ECOVIBES_ADMIN_SUPABASE_USER_IDS=
AUTH_SECRET=

# Supabase server integration. Keep the secret key server-side and out of VITE_* variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

STORAGE_URL=
STORAGE_KEY=
STORAGE_BUCKET=ecovibes-media
PAYSTACK_SECRET_KEY=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=
SHOPIFY_API_VERSION=2026-07
TOKEN_ENCRYPTION_KEY=
# Chale AI: server-side secrets only. AI_PROVIDER_KEY takes precedence.
AI_PROVIDER_KEY=
OPENAI_API_KEY=
# Optional administrator-controlled file containing OPENAI_API_KEY.
# Relative paths resolve from the app root. Never expose this through VITE_*.
OPENAI_ENV_FILE=
AI_MODEL=gpt-6-astra
EMAIL_PROVIDER_KEY=

# LiveKit Cloud or self-hosted server (required for real calls and livestreams)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
