# Server configuration. Keep this template free of credentials.
API_PORT=8787
ECOVIBES_DB_PATH=server/data/ecovibes.sqlite
DATABASE_URL=
DB_POOL_MAX=8
APP_ORIGINS=http://localhost:5173
# Enable only after npm run build, to serve web + API from one origin.
ECOVIBES_SERVE_WEB=false
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
ECOVIBES_ADMIN_SUPABASE_USER_IDS=
AUTH_SECRET=

# Supabase server integration. Keep the secret key server-side and out of VITE_* variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

STORAGE_URL=
STORAGE_KEY=
STORAGE_BUCKET=ecovibes-media
PAYSTACK_SECRET_KEY=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=
SHOPIFY_API_VERSION=2026-07
TOKEN_ENCRYPTION_KEY=
# Chale Free Core: disabled until a model is installed. No paid fallback.
# ollama uses a base such as http://127.0.0.1:11434
# compatible (llama.cpp) uses a base such as http://127.0.0.1:11435/v1
CHALE_PROVIDER=disabled
CHALE_BASE_URL=
CHALE_INFERENCE_KEY=
CHALE_REMOTE_APPROVED=false
CHALE_ALLOW_PAID=false
CHALE_DAILY_REQUESTS=20
CHALE_GUEST_DAILY_REQUESTS=5
CHALE_GLOBAL_DAILY_REQUESTS=200
CHALE_CONCURRENCY=1
CHALE_MAX_OUTPUT_TOKENS=256
CHALE_TIMEOUT_MS=60000
# Optional paid adapter needs explicit CHALE_PROVIDER=openai and approval above.
# Server-side secrets only. AI_PROVIDER_KEY takes precedence.
AI_PROVIDER_KEY=
OPENAI_API_KEY=
# Optional administrator-controlled file containing OPENAI_API_KEY.
# Relative paths resolve from the app root. Never expose this through VITE_*.
OPENAI_ENV_FILE=
AI_MODEL=
# Optional AWS Bedrock (paid, disabled): provider=bedrock, explicit paid + remote approval.
# Keep the bearer token in hosting secrets, never VITE_* or chat.
CHALE_BEDROCK_AUTH=iam
AWS_REGION=
AWS_BEARER_TOKEN_BEDROCK=
EMAIL_PROVIDER_KEY=

# LiveKit Cloud or self-hosted server (required for real calls and livestreams)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
